{
  "name": "secure-file-storage-backend",
  "version": "1.0.0",
  "description": "Secure file storage service API - Express + TypeScript + PostgreSQL",
  "main": "dist/index.js",
  "scripts": {
    "dev": "nodemon --exec ts-node src/index.ts",
    "build": "tsc -p tsconfig.json",
