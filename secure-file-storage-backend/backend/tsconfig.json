{
  "compilerOptions": {
    "target": "ES2020",
    "module": "Node16",
    "lib": ["ES2020", "DOM"],
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "moduleResolution": "node16",
    "declaration": false,
    "sourceMap": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "types": ["node", "express", "cors", "compression", "morgan", "cookie-parser", "pg", "bcryptjs", "jsonwebtoken", "multer", "uuid"]
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist", "storage"]
}
